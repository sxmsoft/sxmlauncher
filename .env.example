# =============================================================================
# SXMLAUNCHER environment template
# =============================================================================
# Copy to `.env` (gitignored) and fill in what you need. Every value is
# OPTIONAL: an empty/unset variable falls back to the default noted below or
# to whatever the user configured in Settings.
#
# How these are read
#   * All SXML_* / SXACC_* variables are read by the Rust backend at RUNTIME
#     (std::env::var in src-tauri/src/config.rs + presence.rs). They are NOT
#     compiled into the binary and NOT exposed to the webview.
#   * The app does not load `.env` by itself. Export it into the shell that
#     starts the app, e.g.:
#         set -a; . ./.env; set +a; pnpm dev:app          # bash / zsh
#   * An env value overrides the matching Settings field while it is set.
#   * Vite only exposes VITE_* / TAURI_ENV_* to the frontend. None are used
#     today — never put a secret in a VITE_* variable, it ends up in the bundle.
#
# Secret vs public
#   [SECRET]  never commit, never log, rotate if leaked
#   [PUBLIC]  public-by-design identifier (safe to ship in a binary)
# =============================================================================

# --- Mods --------------------------------------------------------------------
# [SECRET] CurseForge Core API key (https://console.curseforge.com/).
# Required for CurseForge search/downloads; Modrinth works without it.
# Users can also paste their own key in Settings (stored in the OS vault).
SXML_CURSEFORGE_API_KEY=

# --- Discord Rich Presence ---------------------------------------------------
# [PUBLIC] Discord application id (snowflake) from
# https://discord.com/developers/applications. Upload an art asset with the
# key `sxmlauncher`. Empty = presence disabled. Settings → General has the
# same field; this env var wins. Do NOT put a Discord bot token here.
SXML_DISCORD_APPLICATION_ID=

# --- Microsoft / Xbox sign-in -----------------------------------------------
# [PUBLIC] OAuth public client id. Default: 00000000402b5328 (the legacy
# Minecraft public client, uses the ms-xal- deep-link callback).
# A custom Azure app id switches to Azure AD v2 + PKCE + http://localhost
# loopback; register it as a *public client* (no client secret is used).
SXML_MSA_CLIENT_ID=

# --- Ely.by sign-in ---------------------------------------------------------
# [PUBLIC] Ely.by OAuth client id. Default: sxmlauncher3 (public desktop
# application, no redirect URI, no secret).
SXML_ELYBY_CLIENT_ID=
# [SECRET] Only for your OWN Ely.by *web* application. Leave empty for the
# default desktop client. Set id + secret + redirect together.
SXML_ELYBY_CLIENT_SECRET=
# Must match the web application's registration exactly.
# Default: http://localhost:25564/elyby/callback
SXML_ELYBY_REDIRECT_URI=

# --- sx.acc (SXMWARE account service) ---------------------------------------
# Origin of the sx.acc server, e.g. https://sx-acc.example.com (no trailing
# /v1). Empty = sx.acc provider unavailable unless set in Settings.
# Routes used: POST {BASE}/v1/auth/{register,login,refresh},
# GET/PUT {BASE}/v1/profile[/skin], authlib-injector root {BASE}/authlib/.
SXACC_BASE_URL=

# --- P2P hosting / server directory -----------------------------------------
# Redis directory used for global server listings + signaling.
# [SECRET when it contains credentials] e.g. rediss://default:<token>@<host>:6379
# (Upstash). Default: redis://127.0.0.1:6379/0. The UI/logs show it redacted.
# NOTE: the relay/redis vars are applied even when empty, so keep them
# commented out unless you set a real value.
# SXML_REDIS_URL=
# Fallback tunnel relay when UDP hole punching fails (symmetric NAT).
# Default: wss://relay.sxmlauncher.dev
# SXML_RELAY_URL=
# Comma-separated STUN servers (host:port).
# Default: stun.l.google.com:19302,stun.cloudflare.com:3478
# SXML_STUN_SERVERS=

# --- Misc ---------------------------------------------------------------------
# Any non-empty value marks the install as portable (reported in Settings).
# SXML_PORTABLE=1

# --- Release signing (CI / local release builds only) ----------------------
# [SECRET] Tauri updater signing key. In CI these come from repository
# secrets (secrets.TAURI_SIGNING_PRIVATE_KEY[_PASSWORD]). Locally, keep the
# key in the gitignored .keys/ folder and pass the file *contents*:
#   TAURI_SIGNING_PRIVATE_KEY="$(cat .keys/sxmlauncher.key)"
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
