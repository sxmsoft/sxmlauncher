[TEMPLATE]
# --- Frontend (exposed to the webview, never put secrets here) ---
# Optional: point the UI at a non-default Redis directory service.
VITE_SXML_DIRECTORY_WS=ws://127.0.0.1:6380

# --- Rust backend (read at runtime via std::env::var, never bundled) ---
# CurseForge requires an API key for all v1 endpoints.
SXML_CURSEFORGE_API_KEY=

# Microsoft / Xbox OAuth — public client id (Azure app registration).
# Default is the long-standing Minecraft launcher public client.
# SXML_MSA_CLIENT_ID=00000000402b5328

# Ely.by OAuth.
# The default client `sxmlauncher3` is a public desktop application on Ely.by.
# It has no redirect URI (sending one makes the login page say the application
# was not found) and does not use a client secret. Leave the secret empty.
# To use your own *web* application instead, set all three of the id, the
# secret, and the redirect that you registered (path must match exactly).
SXML_ELYBY_CLIENT_ID=sxmlauncher3
SXML_ELYBY_CLIENT_SECRET=
# SXML_ELYBY_REDIRECT_URI=http://localhost:25564/elyby/callback

# Default STUN servers used for UDP hole punching (comma separated, host:port).
SXML_STUN_SERVERS=stun.l.google.com:19302,stun.cloudflare.com:3478
# Redis signaling/directory endpoint. Also configurable from Settings UI.
SXML_REDIS_URL=redis://127.0.0.1:6379/0
# Fallback tunnel relay used when UDP hole punching fails (symmetric NAT).
SXML_RELAY_URL=wss://relay.sxmlauncher.dev

# --- Updater signing (release builds only, NEVER commit the key) --------
# The keypair lives in .keys/ (gitignored). Release builds set these so the
# produced installers carry a signature the launcher's updater can verify.
# TAURI_SIGNING_PRIVATE_KEY takes the *contents* of the private key file
# (TAURI_SIGNING_PRIVATE_KEY_PATH is not read by tauri-cli 2.x):
# TAURI_SIGNING_PRIVATE_KEY="$(cat .keys/sxmlauncher.key)"
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
