{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SXMLAUNCHER",
  "version": "0.1.0",
  "identifier": "dev.sxmlauncher.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SXMLAUNCHER",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost https: http: data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data: mediacache:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: wss: ws:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/instances/**",
          "$APPDATA/cache/**",
          "$APPDATA/wallpapers/**"
        ]
      }
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Minecraft client, launcher, modpack manager and P2P host",
    "longDescription": "SXMLAUNCHER is an all-in-one open-source Minecraft launcher with instance isolation, Modrinth/CurseForge modpack management and one-click peer-to-peer world hosting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "SXMWARE",
    "licenseFile": "../LICENSE",
    "resources": [],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ms-xal-00000000402b5328", "sxmlauncher"]
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNTc3MjRDNjBDOEI1MTUKUldRVnRjaGdUSEpYNHZrUUZJUUpCYWNncU9BZm9uY1FCSHk3bFBLK1U2bXN5cVRMOUkrcXFJK3gK",
      "endpoints": [
        "https://github.com/sxmlauncher/sxmlauncher/releases/latest/download/latest.json",
        "https://updates.sxmlauncher.dev/latest.json"
      ]
    }
  }
}
